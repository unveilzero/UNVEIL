# Copy to deploy/cloud/.env and fill in. Never commit the filled-in file.

# The address people will open, without https://. Its DNS record must already
# point at this server before the first start, or the certificate cannot be issued.
UNVEIL_DOMAIN=unveil.example.org

# First administrator password. Use a long random one; change it after first login.
ODYSSEUS_ADMIN_PASSWORD=

# Key for the security layer's audit log. Generate one with:
#   openssl rand -hex 32
# Keep a copy somewhere other than this server.
UNVEIL_AUDIT_KEY=

# Where the AI model comes from. A small cloud server cannot run a large model
# itself, so point UNVEIL at a provider (set in the app after login) or fill in:
# OPENAI_API_KEY=

# Optional: stricter blocking rule (see README, Security Layer).
# UNVEIL_GUARD_PROFILE=strict
